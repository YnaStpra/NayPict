# ============================================================
# NayPict E2E Automated Test Suite Environment Variables
# Copy this file to .env.test or pass environment variables in CLI.
# ============================================================

# Target Base URL for testing (Local or Vercel Production Deployment)
# Examples:
#   http://localhost:3000
#   https://naypict.vercel.app
TEST_BASE_URL=http://localhost:3000

# Admin Test Credentials (used to test login, upload, edit, delete)
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=password123
