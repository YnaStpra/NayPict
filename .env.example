# ============================================================
# NayPict Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# App
NODE_ENV=production
TITLE=NayPict

# Database (Neon PostgreSQL)
# Get from: https://neon.tech → your project → Connection String
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Authentication
# MUST be a long, random string — generate with: openssl rand -base64 32
JWT_SECRET=

# Admin credentials (used to seed the first admin user on first startup)
ADMIN=admin
PASSWORD=your_secure_password_here

# ============================================================
# Cloudflare R2 Storage
# Get from: Cloudflare Dashboard → R2 → Manage API Tokens
# ============================================================
STORAGE_PROVIDER=r2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL of your R2 bucket (custom domain or R2.dev subdomain)
R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com

# ============================================================
# Distributed Rate Limiting & Cache (Upstash Redis)
# Get from: https://console.upstash.com → Create Database → REST API
# When configured, rate limiting & cache are automatically shared across all serverless lambda workers.
# When omitted, gracefully falls back to Neon PostgreSQL shared database cache & in-memory sliding window.
# ============================================================
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxx

# ============================================================
# Optional / Feature Flags
# ============================================================
# Demo user (read-only account for public demo)
# NEXT_PUBLIC_DEMO_USERNAME=demo